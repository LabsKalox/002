<?svml using="@hypit/markup@1"?>
<svml>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="media" from="@hypit/media@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="typo" from="@hypit/text-fine@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="look" source="../recipes/look.svs"/>

  <!-- KaloxSooth v2: Veo A-roll in the black studio, phone-filmed plugin demo, rebuilt headline and captions. -->
  <space:Canvas id="canvas" width="1080" height="1920"/>
  <time:Clock id="clock" frame-rate="30"/>

  <space:Extent id="portrait" width="1080" height="1920"/>
  <space:Frame id="full" within={canvas.bounds} left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="head-frame" within={canvas.bounds} left="4%" top="6%" right="96%" bottom="16.5%"/>
  <space:Frame id="caption-frame" within={canvas.bounds} left="6%" top="65%" right="94%" bottom="78%"/>
  <space:Frame id="punch-frame" within={canvas.bounds} left="4%" top="60%" right="96%" bottom="80%"/>
  <space:Frame id="cta-frame" within={canvas.bounds} left="3%" top="55%" right="97%" bottom="63%"/>

  <!-- Material -->
  <media:Video id="aroll-file" src="../../../assets/raw/aroll-preto-B.mp4"/>
  <media:Video id="voice-file" src="../../../references/kalox/source.mp4"/>
  <media:Video id="adjust-file" src="../../../assets/raw/IMG_1740.mov"/>
  <media:Video id="spectrum-file" src="../../../assets/raw/IMG_1739.mov"/>
  <media:Video id="price-file" src="../../../assets/raw/IMG_1741.mov"/>
  <media:Image id="vignette" src="../assets/fx/vignette.png"/>
  <media:Image id="flash" src="../assets/fx/flash.png"/>
  <media:Audio id="whoosh-file" src="../assets/fx/whoosh.wav"/>
  <media:Audio id="hit-file" src="../assets/fx/hit.wav"/>

  <mediaop:Normalize id="aroll" source={aroll-file} clock={clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="voice" source={voice-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <mediaop:Normalize id="adjust" source={adjust-file} clock={clock} video="primary-moving" audio="default" span-authority="video"/>
  <mediaop:Normalize id="spectrum" source={spectrum-file} clock={clock} video="primary-moving" audio="default" span-authority="video"/>
  <mediaop:Normalize id="price" source={price-file} clock={clock} video="primary-moving" audio="default" span-authority="video"/>
  <mediaop:Normalize id="whoosh" source={whoosh-file} clock={clock} video="none" audio="default" span-authority="audio"/>
  <mediaop:Normalize id="hit" source={hit-file} clock={clock} video="none" audio="default" span-authority="audio"/>

  <!-- Time: frame positions measured from the transcripts and the original edit (30 fps). -->
  <time:Timeline id="program" clock={clock} end="start+807f">
    <time:Window id="a1" from="start" until="start+91f"/>
    <time:Window id="a2" from="start+91f" until="start+128f"/>
    <time:Window id="a3" from="start+128f" until="start+222f"/>
    <time:Window id="voice-sound" from="start" until="start+184f"/>
    <time:Window id="s1-sound" from="start+184f" until="start+410f"/>
    <time:Window id="s1" from="start+222f" until="start+410f"/>
    <time:Window id="s2" from="start+410f" until="start+556f"/>
    <time:Window id="s3a" from="start+556f" until="start+590f"/>
    <time:Window id="s3b" from="start+590f" until="start+608f"/>
    <time:Window id="s3c" from="start+608f" until="start+807f"/>
    <time:Window id="s3-sound" from="start+556f" until="start+807f"/>
    <time:Window id="flash-1" from="start+222f" for="7f"/>
    <time:Window id="flash-2" from="start+590f" for="5f"/>
    <time:Window id="whoosh-1" from="start+212f" for="18f"/>
    <time:Window id="whoosh-2" from="start+400f" for="18f"/>
    <time:Window id="whoosh-3" from="start+546f" for="18f"/>
    <time:Window id="whoosh-4" from="start+84f" for="14f"/>
    <time:Window id="hit-1" from="start+590f" for="21f"/>

    <time:Window id="c1" from="start+10f" until="start+49f"/>
    <time:Window id="c2" from="start+49f" until="start+85f"/>
    <time:Window id="c3" from="start+86f" until="start+130f"/>
    <time:Window id="c4" from="start+136f" until="start+157f"/>
    <time:Window id="c5" from="start+157f" until="start+200f"/>
    <time:Window id="l1" from="start+228f" until="start+282f"/>
    <time:Window id="c6" from="start+285f" until="start+322f"/>
    <time:Window id="c7" from="start+323f" until="start+407f"/>
    <time:Window id="l2" from="start+412f" until="start+451f"/>
    <time:Window id="c8" from="start+452f" until="start+481f"/>
    <time:Window id="c9" from="start+482f" until="start+508f"/>
    <time:Window id="c10" from="start+509f" until="start+556f"/>
    <time:Window id="c11" from="start+560f" until="start+587f"/>
    <time:Window id="c12" from="start+590f" until="start+609f"/>
    <time:Window id="c13" from="start+611f" until="start+647f"/>
    <time:Window id="c14" from="start+649f" until="start+687f"/>
    <time:Window id="c15" from="start+689f" until="start+750f"/>
    <time:Window id="c16" from="start+754f" until="start+790f"/>
  </time:Timeline>

  <!-- Picture motion -->
  <visual:Motion id="push">
    <visual:Pose at="start" scale="1.0" origin-y="0.4" easing="linear"/>
    <visual:Pose at="end" scale="1.05" origin-y="0.4"/>
  </visual:Motion>
  <visual:Motion id="punch">
    <visual:Pose at="start" scale="1.16" origin-y="0.36" easing="linear"/>
    <visual:Pose at="end" scale="1.19" origin-y="0.36"/>
  </visual:Motion>
  <visual:Motion id="screen-in">
    <visual:Pose at="start" scale="1.14" easing="ease-out"/>
    <visual:Pose at="9f" scale="1.02" easing="linear"/>
    <visual:Pose at="end" scale="1.07"/>
  </visual:Motion>
  <visual:Motion id="screen-drift">
    <visual:Pose at="start" scale="1.03" easing="linear"/>
    <visual:Pose at="end" scale="1.07"/>
  </visual:Motion>
  <visual:Motion id="screen-punch">
    <visual:Pose at="start" scale="1.22" easing="linear"/>
    <visual:Pose at="end" scale="1.24"/>
  </visual:Motion>
  <visual:Motion id="flash-out">
    <visual:Pose at="start" opacity="0.75" easing="ease-out"/>
    <visual:Pose at="end" opacity="0"/>
  </visual:Motion>

  <visual:Track id="picture" timeline={program.timeline}>
    <visual:Clip id="a1" media={aroll.media} during={program.a1} frame={full} z="10" fit="cover"
      treatment={look.visual.aroll} motion={push}>
      <visual:Map target-from="0f" target-until="6f" source-from="0f" source-until="5f"/>
      <visual:Map target-from="6f" target-until="14f" source-from="5f" source-until="12f"/>
      <visual:Map target-from="14f" target-until="22f" source-from="12f" source-until="21f"/>
      <visual:Map target-from="22f" target-until="30f" source-from="21f" source-until="29f"/>
      <visual:Map target-from="30f" target-until="38f" source-from="29f" source-until="38f"/>
      <visual:Map target-from="38f" target-until="46f" source-from="38f" source-until="46f"/>
      <visual:Map target-from="46f" target-until="54f" source-from="46f" source-until="55f"/>
      <visual:Map target-from="54f" target-until="62f" source-from="55f" source-until="63f"/>
      <visual:Map target-from="62f" target-until="70f" source-from="63f" source-until="72f"/>
      <visual:Map target-from="70f" target-until="78f" source-from="72f" source-until="80f"/>
      <visual:Map target-from="78f" target-until="86f" source-from="80f" source-until="88f"/>
      <visual:Map target-from="86f" target-until="91f" source-from="88f" source-until="94f"/>
    </visual:Clip>
    <visual:Clip id="a2" media={aroll.media} during={program.a2} frame={full} z="10" fit="cover"
      treatment={look.visual.aroll} motion={punch}>
      <visual:Map target-from="0f" target-until="8f" source-from="108f" source-until="118f"/>
      <visual:Map target-from="8f" target-until="16f" source-from="118f" source-until="126f"/>
      <visual:Map target-from="16f" target-until="24f" source-from="126f" source-until="132f"/>
      <visual:Map target-from="24f" target-until="32f" source-from="132f" source-until="141f"/>
      <visual:Map target-from="32f" target-until="37f" source-from="141f" source-until="146f"/>
    </visual:Clip>
    <visual:Clip id="a3" media={aroll.media} during={program.a3} frame={full} z="10" fit="cover"
      treatment={look.visual.aroll} motion={push}>
      <visual:Map target-from="0f" target-until="8f" source-from="146f" source-until="154f"/>
      <visual:Map target-from="8f" target-until="16f" source-from="154f" source-until="159f"/>
      <visual:Map target-from="16f" target-until="24f" source-from="159f" source-until="168f"/>
      <visual:Map target-from="24f" target-until="32f" source-from="168f" source-until="182f"/>
      <visual:Map target-from="32f" target-until="40f" source-from="182f" source-until="189f"/>
      <visual:Map target-from="40f" target-until="48f" source-from="189f" source-until="197f"/>
      <visual:Map target-from="48f" target-until="52f" source-from="197f" source-until="201f"/>
      <visual:Map target-from="52f" target-until="94f" source-from="201f" source-until="239f"/>
    </visual:Clip>
    <visual:Clip id="s1" media={adjust.media} during={program.s1} frame={full} z="10" fit="cover"
      treatment={look.visual.screen} motion={screen-in}>
      <visual:Map target-at="start" source-at="59f" rate="1"/>
    </visual:Clip>
    <visual:Clip id="s2" media={spectrum.media} during={program.s2} frame={full} z="10" fit="cover"
      treatment={look.visual.screen} motion={screen-in}>
      <visual:Map target-at="start" source-at="61f" rate="1"/>
    </visual:Clip>
    <visual:Clip id="s3a" media={price.media} during={program.s3a} frame={full} z="10" fit="cover"
      treatment={look.visual.screen} motion={screen-in}>
      <visual:Map target-at="start" source-at="115f" rate="1"/>
    </visual:Clip>
    <visual:Clip id="s3b" media={price.media} during={program.s3b} frame={full} z="10" fit="cover"
      treatment={look.visual.screen} motion={screen-punch}>
      <visual:Map target-at="start" source-at="149f" rate="1"/>
    </visual:Clip>
    <visual:Clip id="s3c" media={price.media} during={program.s3c} frame={full} z="10" fit="cover"
      treatment={look.visual.screen} motion={screen-drift}>
      <visual:Map target-at="start" source-at="167f" rate="1"/>
    </visual:Clip>
    <visual:Clip id="vignette" image={vignette} extent={portrait} during={program.window} frame={full} z="30" fit="cover"/>
    <visual:Clip id="flash-1" image={flash} extent={portrait} during={program.flash-1} frame={full} z="35" fit="cover" motion={flash-out}/>
    <visual:Clip id="flash-2" image={flash} extent={portrait} during={program.flash-2} frame={full} z="35" fit="cover" motion={flash-out}/>
  </visual:Track>

  <!-- Sound: voices balanced by measured loudness, plus synthesized whooshes and an impact. -->
  <audio:Track id="sound" timeline={program.timeline}>
    <audio:Clip id="user-voice" source={voice.media} during={program.voice-sound} gain="1.05" fade-out="4f">
      <audio:Map target-at="start" source-at="20f" rate="1"/>
    </audio:Clip>
    <audio:Clip id="adjust-voice" source={adjust.media} during={program.s1-sound} gain="1.5" fade-in="6f" fade-out="2f">
      <audio:Map target-at="start" source-at="21f" rate="1"/>
    </audio:Clip>
    <audio:Clip id="spectrum-voice" source={spectrum.media} during={program.s2} gain="1.35" fade-in="2f" fade-out="2f">
      <audio:Map target-at="start" source-at="61f" rate="1"/>
    </audio:Clip>
    <audio:Clip id="price-voice" source={price.media} during={program.s3-sound} gain="1.1" fade-in="2f" fade-out="6f">
      <audio:Map target-at="start" source-at="115f" rate="1"/>
    </audio:Clip>
    <audio:Clip id="whoosh-1" source={whoosh.media} during={program.whoosh-1} gain="0.35"/>
    <audio:Clip id="whoosh-2" source={whoosh.media} during={program.whoosh-2} gain="0.28"/>
    <audio:Clip id="whoosh-3" source={whoosh.media} during={program.whoosh-3} gain="0.28"/>
    <audio:Clip id="whoosh-4" source={whoosh.media} during={program.whoosh-4} gain="0.18"/>
    <audio:Clip id="hit-1" source={hit.media} during={program.hit-1} gain="0.55"/>
  </audio:Track>

  <!-- Typography -->
  <fonts:Face id="mont-black-italic" package="@fontsource-variable/montserrat" weight="900" style="italic"/>
  <fonts:Face id="mont-black" package="@fontsource-variable/montserrat" weight="900" style="normal"/>
  <fonts:Face id="mont-xbold" package="@fontsource-variable/montserrat" weight="800" style="normal"/>

  <typo:Style id="head-line" recipe={look.text.head-line} font={mont-black-italic}>
    <typo:Shadow color="#000000" x="0" y="6" blur="12"/>
    <typo:Stroke color="#000000" width="9" placement="outside"/>
    <typo:Fill color="#FFFFFF"/>
  </typo:Style>
  <typo:Style id="head-big" recipe={look.text.head-big} font={mont-black-italic}>
    <typo:Shadow color="#000000" x="0" y="8" blur="14"/>
    <typo:Stroke color="#000000" width="11" placement="outside"/>
    <typo:Fill color="#FFFFFF"/>
  </typo:Style>
  <typo:Style id="cap" recipe={look.text.caption} font={mont-black}>
    <typo:Shadow color="#000000" x="0" y="6" blur="16"/>
    <typo:Stroke color="#000000" width="6" placement="outside"/>
    <typo:Fill color="#FFFFFF"/>
  </typo:Style>
  <typo:Style id="cap-hi" recipe={look.text.caption} font={mont-black}>
    <typo:Shadow color="#000000" x="0" y="6" blur="16"/>
    <typo:Stroke color="#000000" width="6" placement="outside"/>
    <typo:Fill color="#FFFFFF"/>
  </typo:Style>
  <typo:Style id="punch-style" recipe={look.text.punch} font={mont-black}>
    <typo:Shadow color="#000000" x="0" y="8" blur="20"/>
    <typo:Stroke color="#000000" width="8" placement="outside"/>
    <typo:Fill color="#FFFFFF"/>
  </typo:Style>
  <typo:Style id="label" recipe={look.text.label} font={mont-xbold}>
    <typo:Box target="content" color="#8FE3FF" padding="16 34" radius="44"/>
    <typo:Fill color="#05070A"/>
  </typo:Style>
  <typo:Style id="cta-style" recipe={look.text.cta} font={mont-black}>
    <typo:Box target="content" color="#FFFFFF" padding="18 38" radius="50">
      <typo:BoxShadow color="#2EC5FF" blur="30"/>
    </typo:Box>
    <typo:Fill color="#05070A"/>
  </typo:Style>

  <typo:Motion id="head-in">
    <typo:ItemKeyframe at="0" y="-36" opacity="0"/>
    <typo:ItemKeyframe at="10" y="0" opacity="1" easing="ease-out"/>
  </typo:Motion>
  <typo:Motion id="pop">
    <typo:ItemKeyframe at="0" scale="0.62" opacity="0"/>
    <typo:ItemKeyframe at="4" scale="1.08" opacity="1" easing="ease-out"/>
    <typo:ItemKeyframe at="7" scale="1" opacity="1" easing="ease-in-out"/>
  </typo:Motion>
  <typo:Motion id="slam">
    <typo:ItemKeyframe at="0" scale="1.6" opacity="0"/>
    <typo:ItemKeyframe at="4" scale="0.96" opacity="1" easing="ease-out"/>
    <typo:ItemKeyframe at="7" scale="1" opacity="1"/>
  </typo:Motion>
  <typo:Motion id="pill-in">
    <typo:ItemKeyframe at="0" y="24" scale="0.85" opacity="0"/>
    <typo:ItemKeyframe at="6" y="0" scale="1" opacity="1" easing="ease-out"/>
  </typo:Motion>

  <typo:Flow id="headline" timeline={program.timeline} within={head-frame} style={head-line} z="50"
    motion={head-in} during={program.window} block-align="start">
    <typo:P>Tira o agudo ardido da mix<typo:Break/><typo:Span style={head-big}>DE GRAÇA</typo:Span></typo:P>
  </typo:Flow>

  <typo:Flow id="c1" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c1}>
    <typo:P>Vem cá que eu vou<typo:Break/><typo:Span style={cap-hi}>te mostrar</typo:Span></typo:P>
  </typo:Flow>
  <typo:Flow id="c2" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c2}>
    <typo:P>o que o <typo:Span style={cap-hi}>meu plugin</typo:Span><typo:Break/><typo:Span style={cap-hi}>novo</typo:Span> faz</typo:P>
  </typo:Flow>
  <typo:Flow id="c3" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c3}>
    <typo:P>nessa mix <typo:Span style={cap-hi}>ardida.</typo:Span></typo:P>
  </typo:Flow>
  <typo:Flow id="c4" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c4}>
    <typo:P>Olha isso aqui,</typo:P>
  </typo:Flow>
  <typo:Flow id="c5" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c5}>
    <typo:P>olha <typo:Span style={cap-hi}>isso aqui!</typo:Span></typo:P>
  </typo:Flow>
  <typo:Flow id="l1" inline-size="hug" block-size="hug" timeline={program.timeline} within={caption-frame} style={label} z="60" motion={pill-in} during={program.l1}>
    <typo:P>LIGA O SOM E ESCUTA</typo:P>
  </typo:Flow>
  <typo:Flow id="c6" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c6}>
    <typo:P>E dá pra <typo:Span style={cap-hi}>ajustar</typo:Span></typo:P>
  </typo:Flow>
  <typo:Flow id="c7" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c7}>
    <typo:P><typo:Span style={cap-hi}>tudo depois,</typo:Span> hein?</typo:P>
  </typo:Flow>
  <typo:Flow id="l2" inline-size="hug" block-size="hug" timeline={program.timeline} within={caption-frame} style={label} z="60" motion={pill-in} during={program.l2}>
    <typo:P>OLHA O CORTE NOS PICOS</typo:P>
  </typo:Flow>
  <typo:Flow id="c8" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c8}>
    <typo:P>Olha que <typo:Span style={cap-hi}>doideira,</typo:Span></typo:P>
  </typo:Flow>
  <typo:Flow id="c9" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c9}>
    <typo:P>ele <typo:Span style={cap-hi}>só corta</typo:Span></typo:P>
  </typo:Flow>
  <typo:Flow id="c10" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c10}>
    <typo:P>onde tá <typo:Span style={cap-hi}>ardido.</typo:Span></typo:P>
  </typo:Flow>
  <typo:Flow id="c11" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c11}>
    <typo:P>E o <typo:Span style={cap-hi}>custo?</typo:Span></typo:P>
  </typo:Flow>
  <typo:Flow id="c12" timeline={program.timeline} within={punch-frame} style={punch-style} z="60" motion={slam} during={program.c12}>
    <typo:P>NADA.</typo:P>
  </typo:Flow>
  <typo:Flow id="c13" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c13}>
    <typo:P>É <typo:Span style={cap-hi}>de graça,</typo:Span></typo:P>
  </typo:Flow>
  <typo:Flow id="c14" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c14}>
    <typo:P>tá <typo:Span style={cap-hi}>de graça.</typo:Span></typo:P>
  </typo:Flow>
  <typo:Flow id="c15" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c15}>
    <typo:P>Link na bio,</typo:P>
  </typo:Flow>
  <typo:Flow id="c16" timeline={program.timeline} within={caption-frame} style={cap} z="60" motion={pop} during={program.c16}>
    <typo:P>o bagulho é <typo:Span style={cap-hi}>louco.</typo:Span></typo:P>
  </typo:Flow>

  <film:Film id="main" canvas={canvas.canvas} timeline={program.timeline} appearance={look.film.main}>
    <film:Track source={picture.visual}/>
    <film:Track source={sound.audio}/>
    <film:Track source={headline.visual}/>
    <film:Track source={c1.visual}/>
    <film:Track source={c2.visual}/>
    <film:Track source={c3.visual}/>
    <film:Track source={c4.visual}/>
    <film:Track source={c5.visual}/>
    <film:Track source={l1.visual}/>
    <film:Track source={c6.visual}/>
    <film:Track source={c7.visual}/>
    <film:Track source={l2.visual}/>
    <film:Track source={c8.visual}/>
    <film:Track source={c9.visual}/>
    <film:Track source={c10.visual}/>
    <film:Track source={c11.visual}/>
    <film:Track source={c12.visual}/>
    <film:Track source={c13.visual}/>
    <film:Track source={c14.visual}/>
    <film:Track source={c15.visual}/>
    <film:Track source={c16.visual}/>
  </film:Film>
  <html:Video id="final" composition={main.composition} timeline={program.timeline}/>
  <html:Video id="check-a" composition={main.composition} timeline={program.timeline} start-frame="60" end-frame-exclusive="62"/>
  <html:Video id="check-b" composition={main.composition} timeline={program.timeline} start-frame="250" end-frame-exclusive="252"/>
  <html:Video id="check-c" composition={main.composition} timeline={program.timeline} start-frame="720" end-frame-exclusive="722"/>
</svml>
